rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /meds/{docId} { allow read, write: if true; }
    match /sales/{docId} { allow read, write: if true; }
    match /audit/{docId} { allow read, write: if true; }
    match /expenses/{docId} { allow read, write: if true; }
    match /purchases/{docId} { allow read, write: if true; }
    match /shiftReports/{docId} { allow read, write: if true; }
    match /settings/{docId} { allow read, write: if true; }
    match /{document=**} { allow read, write: if true; }
  }
}
